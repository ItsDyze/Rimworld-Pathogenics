<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>DP_PathogenicFlu</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>pathogenic flu</label>
    <description>A standalone respiratory illness used to prototype the Pathogenics v0.2 disease simulation. It appears as a visible disease after incubation and can be applied manually for testing.</description>
    <isBad>true</isBad>
    <scenarioCanAdd>true</scenarioCanAdd>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>early symptomatic</label>
        <capabilities>
          <li>
            <capability>Moving</capability>
            <offset>0</offset>
          </li>
        </capabilities>
        <statOffsets>
          <Pain>3</Pain>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>late symptomatic</label>
        <capabilities>
          <li>
            <capability>Moving</capability>
            <offset>-0.15</offset>
          </li>
          <li>
            <capability>Manipulation</capability>
            <offset>-0.15</offset>
          </li>
        </capabilities>
        <statOffsets>
          <Pain>8</Pain>
          <GlobalWorkSpeedFactor>-0.15</GlobalWorkSpeedFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
