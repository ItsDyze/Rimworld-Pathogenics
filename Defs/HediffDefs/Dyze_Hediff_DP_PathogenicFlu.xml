<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>DP_PathogenicFlu</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <makesSickThought>true</makesSickThought>
    <scenarioCanAdd>true</scenarioCanAdd>
    <isBad>true</isBad>
    <initialSeverity>0.001</initialSeverity>
    <tendable>true</tendable>
    <comps>
      <li Class="Dyze.RimWorld.Pathogenics.HediffCompProperties_SeverityPerDay">
        <severityPerDay>0.25</severityPerDay>
        <maxSeverity>1.0</maxSeverity>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>early symptomatic</label>
        <painOffset>0.05</painOffset>
      </li>
      <li>
        <minSeverity>0.40</minSeverity>
        <label>late symptomatic</label>
        <painOffset>0.15</painOffset>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.15</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.15</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <label>pathogenic flu</label>
    <description>A standalone respiratory illness used to prototype the Pathogenics v0.2 disease simulation. It appears as a visible disease after incubation and can be applied manually for testing.</description>
  </HediffDef>
</Defs>