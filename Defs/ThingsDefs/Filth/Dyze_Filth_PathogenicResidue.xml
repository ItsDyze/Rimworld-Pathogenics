<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseFilth">
    <defName>Dyze_Filth_PathogenicResidue</defName>
    <label>pathogenic residue</label>
    <description>A faint biological residue left behind by infectious patients. It is unpleasant, unsanitary, and should be cleaned before it spreads through a colony.</description>
    <graphicData>
      <graphicClass>Graphic_Cluster</graphicClass>
      <shaderType>Transparent</shaderType>
      <texPath>Things/Filth/Spatter</texPath>
      <color>(120, 145, 95, 150)</color>
    </graphicData>
    <statBases>
      <Beauty>-12</Beauty>
      <Cleanliness>-8</Cleanliness>
    </statBases>
    <filth>
      <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
      <disappearsInDays>2~4</disappearsInDays>
      <rainWashes>true</rainWashes>
      <cleaningWorkToReduceThickness>60</cleaningWorkToReduceThickness>
      <canFilthAttach>true</canFilthAttach>
    </filth>
  </ThingDef>
</Defs>